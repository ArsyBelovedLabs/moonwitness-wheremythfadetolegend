{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {"key":"Cache-Control","value":"public, max-age=60, stale-while-revalidate=300"}
      ]
    }
  ]
}
